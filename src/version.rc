// File properties shown in Explorer (Details tab) for dinput8.dll.
#include <winver.h>
#include "version.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    SHIM_VERSION_MAJOR, SHIM_VERSION_MINOR, SHIM_VERSION_PATCH, 0
 PRODUCTVERSION SHIM_VERSION_MAJOR, SHIM_VERSION_MINOR, SHIM_VERSION_PATCH, 0
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
 FILEFLAGS      0
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_DLL
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription",  "GTA Vice City launcher shim (dinput8 proxy)"
            VALUE "FileVersion",      SHIM_VERSION_STR
            VALUE "InternalName",     "vc-shim"
            VALUE "OriginalFilename", "dinput8.dll"
            VALUE "ProductName",      "GTA Vice City Launcher Shim"
            VALUE "ProductVersion",   SHIM_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
